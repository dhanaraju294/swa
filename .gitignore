# ============================================================
# Rust
# ============================================================
**/*.rs.bk
Cargo.lock
rust/inward_core/target/
rust/inward_core/Cargo.lock

# ============================================================
# Native binary artifacts.
# The Rust core is committed as source (rust/inward_core) and the native
# libraries below are rebuilt at build time (scripts/build-android-static-libs.sh
# + a Gradle task), so the artifacts themselves are never committed.
# ============================================================
*.a
*.so
*.dylib
*.dll
*.o
*.obj
*.lib
*.jar
!apps/mobile/android/gradle/wrapper/gradle-wrapper.jar
InwardCore.xcframework/
apps/mobile/android/src/main/jniLibs/
apps/mobile/android/app/src/main/jniLibs/

# ============================================================
# Android / Gradle
# ============================================================
apps/mobile/android/.gradle/
apps/mobile/android/.gradle_home/
apps/mobile/android/.android_home/
apps/mobile/android/.home/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/app/.cxx/
apps/mobile/android/local.properties
local.properties
*.keystore
*.jks
captures/
.kotlin/

# ============================================================
# iOS / macOS
# ============================================================
apps/mobile/ios/
apps/mobile/ios/build/
apps/mobile/ios/Pods/
apps/mobile/ios/*.xcworkspace/
apps/mobile/ios/*.xcodeproj/xcuserdata/
apps/mobile/ios/*.xcodeproj/project.xcworkspace/xcuserdata/
DerivedData/
*.xcuserstate
*.xccheckout

# ============================================================
# Secrets & local config (never commit)
# ============================================================
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.cer
*.mobileprovision

