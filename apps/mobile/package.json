{
  "name": "inward-journey",
  "version": "0.1.0",
  "private": true,
  "description": "The Inward Journey mobile app with a Rust backend.",
  "main": "expo-router/entry",
  "repository": {
    "type": "git",
    "url": "https://github.com/inward-journey/inward-core.git"
  },
  "homepage": "https://github.com/inward-journey/inward-core",
  "license": "MIT",
  "author": {
    "name": "The Inward Journey",
    "email": "dev@inwardjourney.app"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "generate:native": "ubrn build ios --and-generate --config ../../ubrn.config.yaml",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "codegenConfig": {
    "name": "InwardCore",
    "type": "modules",
    "jsSrcsDir": "./src/native/generated",
    "outputDir": {
      "ios": "ios/build/generated/ios"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@tanstack/react-query": "^5.101.1",
    "@variant-systems/expo-dynamic-app-icon": "^1.0.2",
    "ajv": "^8.20.0",
    "date-fns": "^4.1.0",
    "expo": "~52.0.0",
    "expo-dev-client": "~5.0.0",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.0",
    "expo-linking": "~7.0.5",
    "expo-local-authentication": "~15.0.0",
    "expo-notifications": "^0.29.14",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-gifted-charts": "^1.4.45",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.14.1",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "uniffi-bindgen-react-native": "0.29.3-1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/react-native": "^12.0.0",
    "@types/react": "~18.3.0",
    "babel-preset-expo": "~12.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.8.0"
  }
}
