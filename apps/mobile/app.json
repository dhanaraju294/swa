{
  "expo": {
    "name": "The Inward Journey",
    "slug": "inward-journey",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "inward-journey",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF6EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inwardjourney.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your private reflections"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF6EC"
      },
      "package": "com.inwardjourney.app",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow The Inward Journey to use Face ID"
        }
      ],
      "./plugins/withRustCore.js"
    ]
  }
}
