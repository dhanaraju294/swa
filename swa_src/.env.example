# ---------------------------------------------------------------------------
# Local dev only. Vercel does NOT read this file — set vars in the dashboard.
# ---------------------------------------------------------------------------

# Where `vite dev` proxies /api requests (your DuckDNS host or raw IP).
VITE_API_PROXY_TARGET=https://swa-backend.duckdns.org

# Leave EMPTY in production so the browser calls same-origin /api/... and the
# vercel.json rewrite forwards it to DuckDNS. Only set this to an absolute URL
# if you intentionally want the browser to hit the backend directly (needs CORS).
VITE_API_BASE_URL=
